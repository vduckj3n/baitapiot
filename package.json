{
  "name": "esp32-iot-system",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace commands for the ESP32 IoT monitoring system",
  "scripts": {
    "dev": "node scripts/system.js dev",
    "stop": "node scripts/system.js stop",
    "restart": "node scripts/system.js restart",
    "status": "node scripts/system.js status",
    "check": "node scripts/check.js",
    "postinstall": "npm --prefix Backend install",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs"
}
