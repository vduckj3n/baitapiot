PORT=3000
FRONTEND_PORT=5500

DB_HOST=localhost
DB_PORT=3307
DB_USER=iot_user
DB_PASSWORD=
DB_NAME=iot_system
DB_TIMEZONE=+07:00

JWT_SECRET=
JWT_EXPIRES_IN=1d

MQTT_HOST=mqtt://localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iot_backend

DEVICE_RESPONSE_TIMEOUT=30000
DEVICE_OFFLINE_TIMEOUT=15000

FRONTEND_ORIGIN=http://localhost:5500

# Optional: path to native Mosquitto executable and password file
# MOSQUITTO_BIN=
# MQTT_PASSWORD_FILE=Backend/mosquitto/passwd

# MySQL auto-start: managed service, or an existing initialized data directory
MYSQL_AUTO_START=true
# MYSQL_SERVICE=MySQL80
# MYSQL_BIN=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqld.exe
# MYSQL_DATA_DIR=/path/to/initialized-mysql-data
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=

# Optional for WSL using Windows MySQL/Node installed at a custom path
# MYSQL_NODE_BIN=C:/Program Files/nodejs/node.exe

